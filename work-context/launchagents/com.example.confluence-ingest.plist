<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.confluence-ingest</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO__/work-context/ingest/run-confluence.sh</string>
    </array>

    <!-- every :05 and :35, hours 12–22 IST (matches former cron: 5,35 12-22 * * *) -->
    <!-- policy: run-confluence.sh skips silently if already succeeded today         -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>35</integer></dict>
        <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>35</integer></dict>
        <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>35</integer></dict>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>35</integer></dict>
        <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>35</integer></dict>
        <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>35</integer></dict>
        <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>35</integer></dict>
        <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>35</integer></dict>
        <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>35</integer></dict>
        <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>35</integer></dict>
        <dict><key>Hour</key><integer>22</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>22</integer><key>Minute</key><integer>35</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>__REPO__/work-context/logs/ingest.log</string>

    <key>StandardErrorPath</key>
    <string>__REPO__/work-context/logs/ingest.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>WorkingDirectory</key>
    <string>__REPO__/work-context</string>
</dict>
</plist>
