<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.leaves</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO__/work-context/derive/run-leaves.sh</string>
    </array>

    <!-- Daily at 04:00 local (IST). Phase 1 only (regex dump + markdown
         render). Phase 2 chat classify runs via /leaves slash skill
         (owner-invoked OR fired by owner's autonomous-session routine). -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>4</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__REPO__/work-context/logs/leaves.log</string>

    <key>StandardErrorPath</key>
    <string>__REPO__/work-context/logs/leaves.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>WorkingDirectory</key>
    <string>__REPO__/work-context</string>
</dict>
</plist>
