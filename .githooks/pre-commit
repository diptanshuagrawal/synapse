#!/usr/bin/env bash
# pre-commit leak guard.
# Blocks a commit if any STAGED file matches a denylist pattern.
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass in a true emergency: git commit --no-verify  (avoid — it defeats the guard)
#
# Scanning is done by .githooks/leak_scan.py (Python re) — NOT grep -E. BSD/macOS
# grep silently mishandles \b in the denylist (\bCBST\b, \b[UCS]0…, \bcbs\b), so a
# grep gate passed real leaks. Do not revert this to grep.
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
SCANNER="$REPO_ROOT/.githooks/leak_scan.py"
fail=0

if [ -f "$SCANNER" ]; then
  python3 "$SCANNER" staged || fail=1
else
  echo "leak-guard: $SCANNER missing — skipping content scan." >&2
fi

# Optional: run gitleaks if installed.
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks protect --staged --redact --no-banner >/dev/null 2>&1; then
    echo "   gitleaks flagged staged changes (run: gitleaks protect --staged --verbose)" >&2
    fail=1
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "Fix the lines above, or add an allow-marker if it's a real placeholder." >&2
  echo "Patterns: .githooks/leak-patterns.txt (+ gitignored .publish-denylist.txt)" >&2
  exit 1
fi
exit 0
